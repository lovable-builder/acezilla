NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/worker only. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Meta (server only). App ID is public; the secret must never be committed or shared.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# 32 random bytes, base64. Encrypts stored ad-platform tokens: `openssl rand -base64 32`
META_TOKEN_KEY=

# Google Ads (server only). The client secret must never be committed or shared.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=

# Authorizes the daily sync job (Vercel Cron sends it automatically). `openssl rand -hex 32`
CRON_SECRET=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_NAME=

# Email (Resend). Create a key at resend.com. RESEND_FROM must use a domain verified in Resend to reach anyone but your own account email.
RESEND_API_KEY=
RESEND_FROM=

# --- AI drafting of SEO fixes (server only; never prefix these with NEXT_PUBLIC_) ---
# Which backend: "vertex" (default) or "aistudio". Switching is an environment change only.
LLM_PROVIDER=
# Vertex AI (service-account auth)
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Region for Vertex: "global", "us", "eu" or a region such as europe-west4. Required; see README.
GOOGLE_VERTEX_LOCATION=
# Optional model ID. Default: gemini-3.1-flash-lite (Vertex) / gemini-flash-latest (AI Studio)
GEMINI_MODEL=
# base64 of the service account JSON key. Set it only as a secret in Vercel / .env.local. Never commit a value.
GOOGLE_SERVICE_ACCOUNT_KEY=
# AI Studio fallback (LLM_PROVIDER=aistudio)
GEMINI_API_KEY=

# Allegro (read-only seller data). ALLEGRO_USER_AGENT is generated in Allegro Developer Apps > User-Agent generator; calls without it get the API key blocked.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_USER_AGENT=
